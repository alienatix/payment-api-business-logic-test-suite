ascanalpha.paymentamount.desc = Checks whether an API accepts a monetary amount that has been altered to an invalid value, such as a negative or zero amount, instead of rejecting it.
ascanalpha.paymentamount.name = Payment Amount Manipulation
ascanalpha.paymentamount.otherinfo.created = The altered amount [{0}] sent in parameter [{1}] received a successful response similar to the response to the original request, whereas a control request with a non-numeric value in the same parameter did not.
ascanalpha.paymentamount.otherinfo.reflected = The altered amount [{0}] sent in parameter [{1}] received a successful response which contains that amount, and which did not appear in the response to the original request.
ascanalpha.paymentamount.refs = https://owasp.org/www-project-web-security-testing-guide/v42/4-Web_Application_Security_Testing/10-Business_Logic_Testing/01-Test_Business_Logic_Data_Validation\nhttps://owasp.org/API-Security/editions/2023/en/0xa6-unrestricted-access-to-sensitive-business-flows/\nhttps://cwe.mitre.org/data/definitions/840.html
ascanalpha.paymentamount.soln = Validate monetary amounts on the server: reject negative, zero, out of range and over-precise values, and do not trust amounts supplied by the client.
